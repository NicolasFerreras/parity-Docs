            ]
          },
          {
            "group": "Producto",
            "pages": [
              "docs/02-product/indice",
              "docs/02-product/scope",
              "docs/02-product/product-definition",
              "docs/02-product/value-proposition",
              "docs/02-product/business-model-canvas",
              "docs/02-product/mvp-definition",
              "docs/04-ux/user-flows",
              "docs/04-ux/prototype"
            ]
          },
