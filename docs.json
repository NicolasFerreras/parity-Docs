  "footerSocials": {
    "github": "https://github.com/NicolasFerreras/parity-Docs"
  },
  "exclude": [
    ".opencode/**",
    "context-map/**",
    "Parity Doc/**",
    "node_modules/**",
    ".git/**",
    "docs/01-research/**",
    "docs/03-requirements/**",
    "docs/06-development/**",
    "docs/07-domain-data/**",
