{
  "$schema": "https://mintlify.com/schema.json",
  "name": "Parity",
  "theme": "mint",
  "logo": {
    "dark": "/logo/dark.svg",
    "light": "/logo/light.svg"
  },
  "favicon": "/favicon.svg",
  "colors": {
    "primary": "#03F07C",
    "light": "#5DE9AA",
    "dark": "#0D9373"
