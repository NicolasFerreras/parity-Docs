          {
            "group": "Overview",
            "pages": [
              "en/docs/00-context/project-overview",
              "en/docs/00-context/project-status",
              "en/docs/00-context/project-glossary",
              "en/docs/00-context/push-rules"
            ]
          },
          {
            "group": "Product",
            "pages": [
              "en/docs/02-product/scope",
              "en/docs/02-product/product-definition",
              "en/docs/02-product/value-proposition",
              "en/docs/02-product/business-model-canvas",
              "en/docs/02-product/mvp-definition",
              "en/docs/04-ux/user-flows",
              "en/docs/04-ux/prototype"
            ]
          },
          {
            "group": "Design",
            "pages": [
              "en/docs/04-ux/ux-ui-guidelines",
              "en/docs/04-ux/design-system"
            ]
          },
          {
            "group": "Technical",
            "pages": [
              "en/docs/05-architecture/architecture",
